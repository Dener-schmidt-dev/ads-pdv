{
  "name": "meupdv-desktop",
  "version": "0.1.0",
  "description": "MeuPDV — PDV offline para minimercados",
  "main": "main.js",
  "author": "MeuPDV",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "br.com.meupdv.desktop",
    "productName": "MeuPDV",
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/api",
        "to": "api",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeuPDV",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["pt_BR", "en_US"]
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  }
}
